# Required for live language-model orchestration. Keep server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL connection for persistent conversations and execution logs.
DATABASE_URL=

# Single-owner sign-in for the initial deployment. Use a long random secret.
RESILIO_ADMIN_PASSWORD=
RESILIO_SESSION_SECRET=

# Optional government mandi feed. Without it, mandi prices are reported unavailable.
AGMARKNET_API_KEY=
